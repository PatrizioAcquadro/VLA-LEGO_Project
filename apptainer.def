Bootstrap: docker
From: pytorch/pytorch:2.10.0-cuda12.8-cudnn9-runtime

%files
    pyproject.toml /tmp/pyproject.toml
    scripts/container_dependencies.py /tmp/container_dependencies.py
    scripts/container-entrypoint.sh /usr/local/bin/entrypoint.sh

%post
    apt-get update && apt-get install -y --no-install-recommends git python3-venv libegl1 libgl1 libosmesa6 libglfw3
    rm -rf /var/lib/apt/lists/*
    python -m pip uninstall --break-system-packages -y spin
    python -m venv --system-site-packages /opt/vla-env
    export PATH=/opt/vla-env/bin:$PATH
    python /tmp/container_dependencies.py /tmp/pyproject.toml > /tmp/requirements.txt
    python -m pip install --no-cache-dir -r /tmp/requirements.txt
    python -m pip check
    rm /tmp/pyproject.toml /tmp/container_dependencies.py /tmp/requirements.txt
    chmod +x /usr/local/bin/entrypoint.sh

%environment
    export PATH=/opt/vla-env/bin:$PATH
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export MUJOCO_GL=egl

%runscript
    exec /usr/local/bin/entrypoint.sh "$@"

%test
    python -c "import torch, mujoco, transformers; print(torch.__version__, mujoco.__version__, transformers.__version__)"

%help
    Build from the repository root. Bind the matching checkout at /workspace and use --nv.
    apptainer run --nv -B "$PWD:/workspace" vla-lego.sif python -m sim.demo --output-dir outputs/demo
